# Public web
PLATEWATCH_WEB_PORT=3000
PLATEWATCH_WEB_ORIGIN=http://localhost:3000

# Service authentication - CHANGE THESE in .env
PLATEWATCH_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
PLATEWATCH_ADMIN_TOKEN=replace-with-a-long-random-admin-token
PLATEWATCH_OPERATOR_TOKEN=replace-with-a-long-random-operator-token
PLATEWATCH_SESSION_SECRET=replace-with-at-least-32-random-characters
PLATEWATCH_SESSION_SECURE=false
PLATEWATCH_SESSION_HOURS=12

# Server / database
PLATEWATCH_SERVER_PORT=8080
PLATEWATCH_API_TIMEOUT_SECONDS=5
PLATEWATCH_RATE_LIMIT_PUBLIC_RPM=120
PLATEWATCH_RATE_LIMIT_INTERNAL_RPM=1200
PLATEWATCH_RATE_LIMIT_ADMIN_RPM=60
PLATEWATCH_RATE_LIMIT_LOGIN_RPM=10
PLATEWATCH_SERVER_URL=http://server:8080
POSTGRES_DB=platewatch
POSTGRES_USER=platewatch
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://platewatch:replace-with-a-strong-database-password@postgres:5432/platewatch?sslmode=disable

# Optional development seed
PLATEWATCH_FLAGGED_PLATES=ABC1234,XYZ9876

# Model bootstrap
PLATEWATCH_VEHICLE_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt
PLATEWATCH_PLATE_MODEL_URL=https://huggingface.co/morsetechlab/yolov11-license-plate-detection/resolve/main/license-plate-finetune-v1n.pt

# Vision worker
# Keep false until a webcam/device is mapped into Docker or an RTSP source is configured.
PLATEWATCH_VISION_AUTO_START=false
PLATEWATCH_LOG_LEVEL=INFO
PLATEWATCH_CAMERA_ID=CAM-01
PLATEWATCH_VISION_SOURCE=0
PLATEWATCH_VEHICLE_MODEL=/models/yolo11n.pt
PLATEWATCH_VEHICLE_CONFIDENCE=0.35
PLATEWATCH_PLATE_MODEL=/models/license_plate.pt
PLATEWATCH_PLATE_CONFIDENCE=0.50
PLATEWATCH_VISION_IMAGE_SIZE=640
PLATEWATCH_VISION_DEVICE=
PLATEWATCH_INFERENCE_STRIDE=2
PLATEWATCH_TRACK_IOU_THRESHOLD=0.30
PLATEWATCH_TRACK_MAX_MISSES=8
PLATEWATCH_OCR_ENGINE=paddleocr
PLATEWATCH_OCR_LANG=en
PLATEWATCH_OCR_MIN_CONFIDENCE=0.70
PLATEWATCH_OCR_CONFIRMATION_COUNT=3
PLATEWATCH_OCR_INTERVAL_FRAMES=3
PLATEWATCH_PLATE_MIN_QUALITY=0.35
PLATEWATCH_PUBLISH_TIMEOUT_SECONDS=2.0
PLATEWATCH_PUBLISH_MAX_ATTEMPTS=3
PLATEWATCH_PUBLISH_BACKOFF_SECONDS=0.25

# Evidence storage inside the vision container
PLATEWATCH_EVIDENCE_DIR=/evidence
PLATEWATCH_EVIDENCE_URL_PREFIX=/evidence
